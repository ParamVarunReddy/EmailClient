# ─────────────────────────────────────────────
# EmailClient — Environment Variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string

# ── Gmail (Google OAuth 2.0) ──────────────────
# https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/receptions/auth/gmail/callback

# ── Outlook (Azure AD / Microsoft Identity) ──
# https://portal.azure.com/ → App registrations
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:3000/receptions/auth/outlook/callback

# ── IMAP defaults ─────────────────────────────
# These are just defaults; per-request credentials are passed in POST /receptions/auth/imap
IMAP_DEFAULT_PORT=993
IMAP_DEFAULT_TLS=true

# ── Yahoo Mail ────────────────────────────────
# Auth via POST /receptions/auth/yahoo  { user, password }
# No OAuth credentials needed — uses Yahoo's IMAP servers.
# If 2-step verification is enabled, create an app password at:
# https://myaccount.yahoo.com/security

# ── Apple iCloud ──────────────────────────────
# Auth via POST /receptions/auth/icloud  { user, password }
# No OAuth credentials needed — uses iCloud's IMAP servers.
# Requires an app-specific password from:
# https://appleid.apple.com → Sign-In and Security → App-Specific Passwords

# ── Zoho Mail (OAuth 2.0) ─────────────────────
# https://api-console.zoho.com/ → Self Client or Server-based apps
# Required scopes: ZohoMail.messages.READ CREATE UPDATE DELETE, ZohoMail.folders.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/receptions/auth/zoho/callback

# ── AI (OpenAI) ───────────────────────────────
# Set AI_STUB_MODE=false and provide a key to use a real LLM.
# When AI_STUB_MODE=true (default) all AI endpoints return canned stub responses.
OPENAI_API_KEY=
AI_MODEL=gpt-4o
AI_STUB_MODE=true
